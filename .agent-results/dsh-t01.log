    <type>file</type>
    <content>
    1: #!/usr/bin/env bash
    2: # 工作流护栏：无 ADR/SPEC 不建票；无票不派重型 agent（codex 豁免）
    3: set -euo pipefail
    4: input=$(cat)
    5: tool=$(jq -r '.tool_name // ""' <<<"$input")
    6: 
    7: deny() {
    8:   jq -n --arg reason "$1" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$reason}}'
    9:   exit 0
    10: }
    11: 
    12: # 规则一：往 .scratch/*/issues/ 建票前，同目录要有 spec.md，且仓库有 ADR（docs/adr 或 .agents/adr）
    13: if [[ "$tool" == "Write" || "$tool" == "Edit" || "$tool" == "MultiEdit" ]]; then
    14:   f=$(jq -r '.tool_input.file_path // ""' <<<"$input")
    15:   if [[ "$f" == *".scratch/"*"/issues/"*".md" ]]; then
    16:     feature=$(dirname "$(dirname "$f")")
    17:     root=$(dirname "$(dirname "$feature")")
