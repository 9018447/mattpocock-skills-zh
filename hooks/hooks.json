{
  "description": "工作流护栏：无 ADR/SPEC 不建实施票；无实施票不通过 acpx 派发 omp/dsh/kimi/zcode（codex 豁免）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
